{
  "name": "plot-widget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:widget": "vite serve './src/widgets/plot'",
    "build": "tsc -p tsconfig.app.json && vite build && youtrack-app validate dist",
    "build:nolint": "vite build && youtrack-app validate dist",
    "lint": "eslint . --ext cjs,js,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "echo 'no tests'",
    "pack": "rm -rf plot-widget.zip && cd dist && zip -r ../plot-widget.zip .",
    "load_env_vars": "set -a && source .env && set +a",
    "upload": "source .env && youtrack-app upload dist --host $YOUTRACK_HOST --token $YOUTRACK_API_TOKEN"
  },
  "dependencies": {
    "@jetbrains/ring-ui-built": "^7.0.129",
    "core-js": "3.47.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@jetbrains/eslint-config": "^6.0.5",
    "@jetbrains/youtrack-apps-tools": "^0.0.2",
    "@jetbrains/youtrack-scripting-api": "^2022.1.46592",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "allowScripts": {
    "core-js@3.47.0": true,
    "esbuild@0.28.2": true
  }
}
